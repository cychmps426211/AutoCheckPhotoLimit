# ===================================================
# AutoCheckPhotoLimit 環境變數範本 (.env.example)
# 請複製此檔案為 .env 並填入實際連線與認證資訊
# ===================================================

# Seiwa 後台網站設定
SEIWA_BASE_URL=https://dl02.seiwainc.com.tw
SEIWA_ACCOUNT=your_seiwa_account_here
SEIWA_PASSWORD=your_seiwa_password_here
DEFAULT_TECHNICIAN_UNO=91
# 協同機台設定檔路徑 (選填，預設為 config/collaborative_machines.json)
# COLLABORATIVE_CONFIG_PATH=config/collaborative_machines.json

# Line Messaging API 憑證 (由 Line Developers Console 取得)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 服務監聽埠號 (Render 雲端平台會自動注入 PORT 環境變數)
PORT=8000

# 預設查詢設定 (選填，預設為 s=0 全部狀態，剩餘張數門檻 <= 20 張)
# DEFAULT_QUERY_STATUS=0
# DEFAULT_QUERY_THRESHOLD=20

# 異常/排除機台清單 (選填，代號以逗號分隔；名稱關鍵字以逗號分隔)
# EXCLUDED_MACHINE_IDS=ABC158-ND
# EXCLUDED_MACHINE_NAMES=高雄職訓中心

# 值班查詢責任區域設定 (選填，預設為 46 南區)
# DUTY_AREA_NO=46
# DUTY_AREA_NAME=南區
