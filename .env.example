# ===================================================
# AutoCheckPhotoLimit 環境變數範本 (.env.example)
# 請複製此檔案為 .env 並填入實際連線與認證資訊
# ===================================================

# Seiwa 後台網站設定
SEIWA_BASE_URL=https://dl02.seiwainc.com.tw
SEIWA_ACCOUNT=your_seiwa_account_here
SEIWA_PASSWORD=your_seiwa_password_here
DEFAULT_TECHNICIAN_UNO=91

# Line Messaging API 憑證 (由 Line Developers Console 取得)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 服務監聽埠號 (Render 雲端平台會自動注入 PORT 環境變數)
PORT=8000
